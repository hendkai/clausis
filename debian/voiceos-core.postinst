#!/bin/sh
set -eu

if ! getent group voiceos >/dev/null; then
    addgroup --system voiceos
fi
if ! getent group voiceos-audit >/dev/null; then
    addgroup --system voiceos-audit
fi
if ! getent passwd voiceos-broker >/dev/null; then
    adduser --system --ingroup voiceos --home /nonexistent --no-create-home voiceos-broker
fi
if ! id -nG voiceos-broker | tr ' ' '\n' | grep -qx voiceos-audit; then
    adduser voiceos-broker voiceos-audit
fi
if ! getent passwd voiceos-confirm >/dev/null; then
    adduser --system --ingroup audio --home /nonexistent --no-create-home voiceos-confirm
fi

install -d -m 0700 -o root -g root /etc/voiceos
install -d -m 0750 -o voiceos-broker -g voiceos /var/log/voiceos

if [ ! -s /etc/voiceos/capability.key ]; then
    head -c 32 /dev/urandom > /etc/voiceos/capability.key
    chmod 0640 /etc/voiceos/capability.key
    chown root:voiceos /etc/voiceos/capability.key
fi
if [ ! -s /etc/voiceos/audit.key ]; then
    head -c 32 /dev/urandom > /etc/voiceos/audit.key
    chmod 0640 /etc/voiceos/audit.key
    chown root:voiceos-audit /etc/voiceos/audit.key
fi

exit 0
