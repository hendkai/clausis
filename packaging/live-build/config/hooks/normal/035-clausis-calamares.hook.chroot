#!/bin/sh
set -eu

settings=/etc/calamares/settings.conf
test -f "${settings}"

# Calamares does not derive a custom instance's configuration filename from
# the `module@id` sequence entry. Without these explicit mappings both jobs
# silently fall back to shellprocess.conf and execute no Clausis command.
sed -i '/^sequence:/i\
instances:\
  - module: shellprocess\
    id: clausis-guard\
    config: shellprocess@clausis-guard.conf\
  - module: shellprocess\
    id: clausis\
    config: shellprocess@clausis.conf\
' "${settings}"

# Register the Clausis post-install job after Calamares has created the target
# user. Restrict the edit to the execution phase; the view sequence also has a
# users entry and must remain unchanged.
sed -i '/^- exec:/,/^- show:/ {
    /^  - partition$/i\  - shellprocess@clausis-guard
    /^  - users$/a\  - shellprocess@clausis
}' "${settings}"
sed -i 's/^prompt-install: false$/prompt-install: true/' "${settings}"

chmod 0755 /usr/bin/clausis-finalize-hermes-install
