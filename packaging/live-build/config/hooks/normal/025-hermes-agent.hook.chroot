#!/bin/sh
set -eu

hermes_commit='0957277f2f468bac22bbfcfa7c43029858c9597e'
hermes_version='0.20.0'
uv_version='0.9.28'
install_dir='/opt/hermes-agent'

install -d -m 0755 "${install_dir}" /usr/share/doc/hermes-agent
git -C "${install_dir}" init
git -C "${install_dir}" remote add origin https://github.com/NousResearch/hermes-agent.git
git -C "${install_dir}" fetch --depth 1 origin "${hermes_commit}"
git -C "${install_dir}" checkout --detach FETCH_HEAD
test "$(git -C "${install_dir}" rev-parse HEAD)" = "${hermes_commit}"

python3 -m venv /opt/clausis-hermes-updater
/opt/clausis-hermes-updater/bin/pip install --no-cache-dir "uv==${uv_version}"
UV_NO_CONFIG=1 \
UV_PROJECT_ENVIRONMENT="${install_dir}/venv" \
    /opt/clausis-hermes-updater/bin/uv sync \
    --frozen --no-dev --extra cli --extra voice --extra anthropic \
    --python /usr/bin/python3 \
    --project "${install_dir}"

ln -s "${install_dir}/venv/bin/hermes" /usr/local/bin/hermes
install -m 0644 "${install_dir}/LICENSE" /usr/share/doc/hermes-agent/LICENSE
install -D -m 0644 "${install_dir}/apps/desktop/assets/icon.png" \
    /usr/share/pixmaps/hermes-agent.png
printf '%s\n' "${hermes_version} ${hermes_commit}" > /usr/share/doc/hermes-agent/UPSTREAM_VERSION

# The pinned uv environment remains available to the Calamares updater.  It
# installs only an exact official release tag using that release's uv.lock.
