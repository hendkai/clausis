From: Clausis contributors <maintainers@example.invalid>
Subject: luksbootkeyfile: install staged Clausis recovery key

The pre-write guard speaks a high-entropy decimal recovery key and stages it
in root-only tmpfs only after binding the exact destructive target. Consume
that key inside Calamares, where the existing LUKS passphrase is already held,
add it to the encrypted root volume, and delete both temporary copies. Never
place either key on a process command line.

---
 src/modules/luksbootkeyfile/LuksBootKeyFileJob.cpp | 137 +++++++++++++++++++--
 1 file changed, 128 insertions(+), 9 deletions(-)

diff --git a/src/modules/luksbootkeyfile/LuksBootKeyFileJob.cpp b/src/modules/luksbootkeyfile/LuksBootKeyFileJob.cpp
index 2c804d4..8940ec2 100644
--- a/src/modules/luksbootkeyfile/LuksBootKeyFileJob.cpp
+++ b/src/modules/luksbootkeyfile/LuksBootKeyFileJob.cpp
@@ -16,7 +16,10 @@
 #include "JobQueue.h"
 
 #include <QDir>
+#include <QFile>
+#include <QFileInfo>
 #include <QRegularExpression>
+#include <QString>
 
 LuksBootKeyFileJob::LuksBootKeyFileJob( QObject* parent )
     : Calamares::CppJob( parent )
@@ -100,6 +103,95 @@ struct LuksDeviceList
 };
 
 static const char keyfile[] = "/crypto_keyfile.bin";
+static const char recoveryStagingFile[] = "/run/clausis-installer/recovery.key";
+static const char recoveryTargetFile[] = "/clausis_recovery.key";
+static const char recoveryInstalledMarker[] = "/run/clausis-installer/recovery-installed";
+
+enum class RecoveryKeyState
+{
+    Absent,
+    Invalid,
+    Ready
+};
+
+static RecoveryKeyState
+loadStagedRecoveryKey( QByteArray& recoveryKey )
+{
+    QFileInfo info( QString::fromLatin1( recoveryStagingFile ) );
+    if ( !info.exists() )
+    {
+        return RecoveryKeyState::Absent;
+    }
+
+    const auto unsafePermissions = QFileDevice::ReadGroup | QFileDevice::WriteGroup | QFileDevice::ExeGroup
+        | QFileDevice::ReadOther | QFileDevice::WriteOther | QFileDevice::ExeOther;
+    if ( !info.isFile() || info.isSymLink() || info.ownerId() != 0 || ( info.permissions() & unsafePermissions )
+         || info.size() < 60 || info.size() > 128 )
+    {
+        cError() << "Clausis recovery-key staging file has unsafe metadata.";
+        return RecoveryKeyState::Invalid;
+    }
+
+    QFile staged( QString::fromLatin1( recoveryStagingFile ) );
+    if ( !staged.open( QIODevice::ReadOnly ) )
+    {
+        cError() << "Could not open Clausis recovery-key staging file.";
+        return RecoveryKeyState::Invalid;
+    }
+    recoveryKey = staged.readAll().trimmed();
+    staged.close();
+    static const QRegularExpression recoveryKeyPattern(
+        QStringLiteral( R"(^[0-9]{4}(?:-[0-9]{4}){11}$)" ) );
+    if ( !recoveryKeyPattern.match( QString::fromLatin1( recoveryKey ) ).hasMatch() )
+    {
+        recoveryKey.fill( 'A' );
+        cError() << "Clausis recovery key has an invalid format.";
+        return RecoveryKeyState::Invalid;
+    }
+    return RecoveryKeyState::Ready;
+}
+
+static bool
+createTargetRecoveryKey( QByteArray& recoveryKey )
+{
+    Calamares::UMask m( Calamares::UMask::Safe );
+    QByteArray fileData = recoveryKey + '\n';
+    auto result = Calamares::System::instance()->createTargetFile(
+        QString::fromLatin1( recoveryTargetFile ), fileData, Calamares::System::WriteMode::Overwrite );
+    recoveryKey.fill( 'A' );
+    fileData.fill( 'A' );
+    return bool( result );
+}
+
+static void
+removeStagedRecoveryKey()
+{
+    QFile staged( QString::fromLatin1( recoveryStagingFile ) );
+    if ( staged.open( QIODevice::ReadWrite ) )
+    {
+        QByteArray overwrite( staged.size(), '0' );
+        staged.seek( 0 );
+        staged.write( overwrite );
+        staged.flush();
+        overwrite.fill( 'A' );
+        staged.resize( 0 );
+        staged.close();
+    }
+    QFile::remove( QString::fromLatin1( recoveryStagingFile ) );
+}
+
+static bool
+markRecoveryInstalled()
+{
+    Calamares::UMask m( Calamares::UMask::Safe );
+    QFile marker( QString::fromLatin1( recoveryInstalledMarker ) );
+    if ( !marker.open( QIODevice::WriteOnly | QIODevice::Truncate ) )
+    {
+        return false;
+    }
+    marker.setPermissions( QFileDevice::ReadOwner | QFileDevice::WriteOwner );
+    return marker.write( "installed\n" ) == 10 && marker.flush();
+}
 
 static bool
 generateTargetKeyfile()
@@ -129,7 +219,7 @@ generateTargetKeyfile()
 }
 
 static bool
-setupLuks( const LuksDevice& d, const QString& luks2Hash )
+setupLuks( const LuksDevice& d, const QString& luks2Hash, const QString& newKeyfile = QString::fromLatin1( keyfile ) )
 {
     // Get luksDump for this device
     auto luks_dump = Calamares::System::instance()->targetEnvCommand(
@@ -181,7 +271,7 @@ setupLuks( const LuksDevice& d, const QString& luks2Hash )
     }
 
     // Add the key to the keyfile
-    QStringList args = { QStringLiteral( "cryptsetup" ), QStringLiteral( "luksAddKey" ), d.device, keyfile };
+    QStringList args = { QStringLiteral( "cryptsetup" ), QStringLiteral( "luksAddKey" ), d.device, newKeyfile };
     if ( luks_version == 2 && luks2Hash != QString() )
     {
         args.insert( 2, "--pbkdf" );
@@ -283,13 +373,6 @@ LuksBootKeyFileJob::exec()
         return Calamares::JobResult::ok();
     }
 
-    if ( hasUnencryptedSeparateBoot() )
-    {
-        // /boot partition is not encrypted, keyfile must not be used.
-        cDebug() << Logger::SubEntry << "/boot partition is not encrypted, skipping keyfile creation.";
-        return Calamares::JobResult::ok();
-    }
-
     if ( s.devices.first().passphrase.isEmpty() )
     {
         cDebug() << Logger::SubEntry << "No root passphrase.";
@@ -296,6 +380,47 @@ LuksBootKeyFileJob::exec()
             tr( "Encrypted rootfs setup error" ),
             tr( "Root partition %1 is LUKS but no passphrase has been set." ).arg( s.devices.first().device ) );
     }
+
+    QByteArray recoveryKey;
+    const auto recoveryState = loadStagedRecoveryKey( recoveryKey );
+    if ( recoveryState == RecoveryKeyState::Invalid )
+    {
+        removeStagedRecoveryKey();
+        return Calamares::JobResult::error(
+            tr( "Encrypted rootfs setup error" ), tr( "The staged Clausis recovery key is invalid." ) );
+    }
+    if ( recoveryState == RecoveryKeyState::Ready )
+    {
+        if ( !createTargetRecoveryKey( recoveryKey ) )
+        {
+            removeStagedRecoveryKey();
+            return Calamares::JobResult::error(
+                tr( "Encrypted rootfs setup error" ), tr( "Could not stage the Clausis recovery key." ) );
+        }
+        const bool recoveryAdded
+            = setupLuks( s.devices.first(), m_luks2Hash, QString::fromLatin1( recoveryTargetFile ) );
+        Calamares::System::instance()->removeTargetFile( QString::fromLatin1( recoveryTargetFile ) );
+        removeStagedRecoveryKey();
+        if ( !recoveryAdded )
+        {
+            return Calamares::JobResult::error(
+                tr( "Encrypted rootfs setup error" ), tr( "Could not add the Clausis recovery key." ) );
+        }
+        if ( !markRecoveryInstalled() )
+        {
+            return Calamares::JobResult::error(
+                tr( "Encrypted rootfs setup error" ), tr( "Could not record recovery-key installation." ) );
+        }
+        cDebug() << "Clausis recovery key was installed without exposing key material.";
+    }
+
+    if ( hasUnencryptedSeparateBoot() )
+    {
+        // A separate /boot must not get an automatic boot key. The Clausis
+        // recovery key above is an independently exported emergency key.
+        cDebug() << Logger::SubEntry << "/boot partition is not encrypted, skipping boot-key creation.";
+        return Calamares::JobResult::ok();
+    }
 
     if ( !generateTargetKeyfile() )
     {
