[Unit]
Description=VoiceOS typed action broker
After=dbus.service
Before=voiceos-runtime.service

[Service]
Type=simple
User=voiceos-broker
Group=voiceos
ExecStart=/usr/bin/voiceos-broker
LoadCredential=capability.key:/etc/voiceos/capability.key
LoadCredential=audit.key:/etc/voiceos/audit.key
Environment=VOICEOS_EXECUTE=0
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/log/voiceos
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target

