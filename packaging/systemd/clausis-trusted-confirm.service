[Unit]
Description=Clausis trusted confirmation authority
After=dbus.service sound.target
Before=clausis-runtime.service

[Service]
Type=simple
User=clausis-confirm
Group=audio
ExecStart=/usr/bin/clausis-trusted-confirm
LoadCredential=capability.key:/etc/clausis/capability.key
LoadCredential=voice-pin.json:/etc/clausis/voice-pin.json
NoNewPrivileges=yes
PrivateDevices=no
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target

