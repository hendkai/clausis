[Unit]
Description=Clausis trusted confirmation authority
ConditionPathExists=/etc/clausis/voice-pin.json
Requires=clausis-action-broker.service
After=dbus.service sound.target clausis-action-broker.service
Before=clausis-runtime.service

[Service]
Type=simple
User=clausis-confirm
Group=audio
SupplementaryGroups=clausis-control
ExecStart=/usr/bin/clausis-trusted-confirm-runtime
LoadCredential=capability.key:/etc/clausis/capability.key
LoadCredential=voice-pin.json:/etc/clausis/voice-pin.json
NoNewPrivileges=yes
PrivateDevices=no
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
