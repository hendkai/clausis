[Unit]
Description=Clausis typed action broker
After=dbus.service
Before=clausis-runtime.service

[Service]
Type=simple
User=clausis-broker
Group=clausis
ExecStart=/usr/bin/clausis-broker
LoadCredential=capability.key:/etc/clausis/capability.key
LoadCredential=audit.key:/etc/clausis/audit.key
Environment=CLAUSIS_EXECUTE=0
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/log/clausis
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target

